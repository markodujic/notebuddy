import type { Meta, StoryObj } from "@storybook/react-native";
import { useState } from "react";

import { SegmentedControl, type Segment } from "./segmented-control";

type ModeValue = "overview" | "focus" | "detail";

const SEGMENTS: Segment<ModeValue>[] = [
  { label: "Overview", value: "overview" },
  { label: "Focus", value: "focus" },
  { label: "Detail", value: "detail" },
];

function SegmentedControlWrapper() {
  const [value, setValue] = useState<ModeValue>("overview");
  return (
    <SegmentedControl
      segments={SEGMENTS}
      value={value}
      onValueChange={setValue}
    />
  );
}

const meta: Meta<typeof SegmentedControlWrapper> = {
  title: "SegmentedControl",
  component: SegmentedControlWrapper,
};

export default meta;

type Story = StoryObj<typeof meta>;

export const Default: Story = {};

export const TwoSegments: Story = {
  render: () => {
    type TValue = "light" | "dark";
    const segs: Segment<TValue>[] = [
      { label: "Light", value: "light" },
      { label: "Dark", value: "dark" },
    ];
    return <TwoSegmentsStory segments={segs} />;
  },
};

function TwoSegmentsStory<T extends string>({
  segments,
}: {
  segments: Segment<T>[];
}) {
  const [value, setValue] = useState<T>(segments[0].value);
  return (
    <SegmentedControl
      segments={segments}
      value={value}
      onValueChange={setValue}
    />
  );
}

export const WithIcons: Story = {
  render: () => {
    type TValue = "treble" | "bass";
    const segs: Segment<TValue>[] = [
      { label: "Violin", value: "treble", icon: "♪" },
      { label: "Bass", value: "bass", icon: "♫" },
    ];
    return <TwoSegmentsStory segments={segs} />;
  },
};
